{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Event Model",
  "type": "object",
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string" },
    "site_id": { "type": "string" },
    "asset_id": { "type": "string" },
    "sensor_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "seq_no": { "type": "integer" },
    "source": { "type": "string" },
    "category": { "type": "string" },
    "severity": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "CRITICAL", "FATAL"] },
    "confidence": { "type": "number" },
    "protocol": { "type": "string" },
    "src": { "type": "string" },
    "dst": { "type": "string" },
    "action": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true },
    "rule_id": { "type": "string" },
    "rule_version": { "type": "string" },
    "attck_enterprise": { "type": "array", "items": { "type": "string" } },
    "attck_ics": { "type": "array", "items": { "type": "string" } },
    "quality_flags": { "type": "array", "items": { "type": "string" } },
    "schema_version": { "type": "string" }
  },
  "required": [
    "event_id", "tenant_id", "site_id", "occurred_at", "schema_version"
  ]
}
